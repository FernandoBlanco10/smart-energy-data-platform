# Copiá este archivo a `.env` (ya está en .gitignore) y completá los valores.
# Nunca subas `.env` real a git — ver regla en .context/project-brief.md sección 4.

# --- Airflow: base de datos de metadatos (Postgres) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar_esta_clave
AIRFLOW_DB_NAME=airflow

# --- Airflow: usuario admin de la UI web ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_clave
AIRFLOW_ADMIN_EMAIL=tu-email@ejemplo.com

# --- Airflow: clave de cifrado de credenciales guardadas en la UI ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Kafka (usado por los productores en ingestion/) ---
# Usá 127.0.0.1, no "localhost" — en Windows + Docker Desktop, librdkafka a
# veces resuelve "localhost" a IPv6 (::1) y la conexión falla.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- OpenWeatherMap (Fase 1, weather_producer.py) ---
# Obtené una API key gratuita en https://openweathermap.org/api (plan free: 60 llamadas/min)
OPENWEATHER_API_KEY=

# --- energy_producer.py (Fase 2) ---
# Opcional — default: ingestion/data/PJME_hourly.csv (ver ingestion/data/README.md)
ENERGY_CSV_PATH=

# --- streaming/ (Fase 2, Spark Structured Streaming + Delta Lake) ---
# Todas opcionales — defaults en streaming/common/spark_session.py y bronze_stream.py
LAKEHOUSE_BASE_PATH=
SPARK_MASTER=
SPARK_KAFKA_CONNECTOR_VERSION=
SPARK_SCALA_SUFFIX=
SPARK_SHUFFLE_PARTITIONS=

# --- agents/nl_query_agent/ (Fase 3, agente NL→SQL sobre Gold) ---
# Conseguí tu key en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional — default: claude-sonnet-5
NL_QUERY_AGENT_MODEL=
# Opcionales — defaults en agents/nl_query_agent/build_gold_catalog.py
SPARK_WAREHOUSE_PATH=
GOLD_DUCKDB_PATH=
