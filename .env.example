# Copiá este archivo a `.env` (ya está en .gitignore) y completá los valores.
# Nunca subas `.env` real a git — ver regla en .context/project-brief.md sección 4.

# --- Airflow: base de datos de metadatos (Postgres) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=cambiar_esta_clave
AIRFLOW_DB_NAME=airflow

# --- Airflow: usuario admin de la UI web ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_clave
AIRFLOW_ADMIN_EMAIL=tu-email@ejemplo.com

# --- Airflow: clave de cifrado de credenciales guardadas en la UI ---
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Kafka (usado por los productores en ingestion/) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- OpenWeatherMap (Fase 1, weather_producer.py) ---
# Obtené una API key gratuita en https://openweathermap.org/api (plan free: 60 llamadas/min)
OPENWEATHER_API_KEY=
