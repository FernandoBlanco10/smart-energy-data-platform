# Secretos y config local — nunca versionar
.env
*.tfvars
!*.tfvars.example
terraform.tfstate
terraform.tfstate.backup
.terraform/
.terraform.lock.hcl
override.tf
# Airflow runtime (se genera al levantar el stack)
airflow/logs/
airflow/plugins/__pycache__/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Spark / checkpoints locales
**/_checkpoint/
**/*.crc
**/_SUCCESS

# Datos crudos pesados (no versionar datasets grandes)
data/raw/
*.csv
!ingestion/sample_data/*.csv

# Lakehouse local (Bronze/Silver/Gold) — datos generados, no código
streaming/lakehouse/
derby.log
metastore_db/

# Logs de ejecución — se regeneran en cada corrida, no aportan como código
**/logs/*.log

# dbt — config local con rutas de tu máquina, y artefactos generados
transformation/profiles.yml
transformation/dbt_project/target/
transformation/dbt_project/dbt_packages/
transformation/dbt_project/logs/
transformation/dbt_project/spark-warehouse/

# Catálogo DuckDB del agente NL→SQL — se regenera con build_gold_catalog.py
transformation/gold.duckdb

# Sistema
.DS_Store
